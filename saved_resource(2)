:[2275,2274,2276],desc:"Наносит урон водой, который зависит от уровня заклинания, от силы, мудрости и сокрушения мага, а также здоровья, мудрости и стойкости противника. От стрел можно уворачиваться, как от обычных ударов."},{min:41,max:59,added:[2278,2277,2279],desc:"Наносит урон землёй, который зависит от уровня заклинания, от силы, мудрости и сокрушения мага, а также здоровья, мудрости и стойкости противника. От стрел можно уворачиваться, как от обычных ударов."},{min:101,max:114,added:[2201,2200,2199],desc:"Увеличивает модификатор сокрушения персонажа на 2 раунда. Эффект зависит от уровня приема. Применяется на себя."},{min:121,max:134,added:[2204,2203,2202],desc:"Увеличивает модификатор точности персонажа на 2 раунда. Эффект зависит от уровня приема. Применяется на себя."},{min:141,max:154,added:[2207,2206,2205],desc:"Увеличивает модификатор стойкости персонажа на 2 раунда или выбранного союзника на 1 раунд. Эффект зависит от уровня приема. Применяется на себя или союзника."},{min:161,max:174,added:[2210,2209,2208],desc:"Увеличивает модификатор уворота персонажа на 2 раунда. Эффект зависит от уровня приема. Применяется на себя."},{min:201,max:214,added:[2213,2212,2211],desc:"Критические удары по противнику восстанавливают жизни персонажу в размере 25% от суммарного урона этих ударов. Максимальный эффект зависит от уровня приема."},{min:221,max:234,added:[2216,2215,2214],desc:"Увеличивает броню всех точек персонажа на 2 раунда. Эффект зависит от уровня приема. Применяется на себя или союзника."},{min:241,max:254,added:[],desc:"Противник в течение трех раундов после использования приема будет терять жизни из-за отравления. Оно равно 20% от нанесенного в этом раунде урона, но максимальный эффект зависит от уровня приема."},{min:261,max:274,added:[2219,2218,2217],desc:"Противник в течение трех раундов после использования приема будет терять жизни из-за кровотечения. Оно равно 20% от нанесенного в этом раунде урона (минимальный урон приема зависит от параметров персонажа), но максимальный эффект зависит от уровня приема. Запрещено использование более 1 аналогичного приема за раунд."},{min:181,max:194,added:[2222,2221,2220],desc:"На 2 раунда увеличиваются дополнительный урон персонажа. Эффект зависит от уровня приема."},{min:281,max:296,added:[2231,2230,2229],desc:"При каждом успешном ударе сжигает часть маны противника, причиняя ему дополнительный урон. Эффект зависит от уровня приема."},{min:301,max:316,added:[2328,2329,2330],desc:"На 1 раунд повышает шансы пробить блоки противника. Эффект зависит от уровня приема."},{min:321,max:337,added:[2245,2244,2246],desc:"Броня всех зон тела противника уменьшается на 2 раунда. Эффект зависит от уровня приема."},{min:341,max:357,added:[2260,2259,2261],desc:"В течение следующего раунда число зон, которые сможет заблокировать персонаж, возрастает на 2. Шанс удачного применения приема зависит от его уровня."},{min:361,max:379,added:[2251,2250,2252],desc:"В течение раунда отражаются все удары, попавшие в блоки персонажа и не пробившие их. Защита от пробоя блока в раунде использования увеличено на 50%. Каждый такой удар наносит урон не персонажу, а тому, кто его нанес. Отраженные удары нельзя заблокировать, от них нельзя увернуться, на них не действует броня. Максимальный урон отраженных ударов и шанс удачного применения приема зависят от его уровня и параметров персонажа. Запрещено использование более 1 аналогичного приема за раунд."},{min:381,max:397,added:[2237,2236,2235],desc:"Удачное попадание по противнику уменьшает максимальное число его блоков в следующем раунде на 2. Шанс удачного применения зависит от уровня приема."},{min:401,max:417,added:[2243,2242,2241],desc:'Если какие-то удары персонажа и его противника будут нацелены в одну и ту же зону, то "совпавшие" удары противника отразятся и нанесут урон ему самому. Отраженные удары нельзя заблокировать, от них нельзя увернуться, на них не действует броня. Максимальный урон отраженных ударов зависит от параметров персонажа, а шанс удачного применения приема зависят от его уровня.'},{min:461,max:477,added:[2257,2256,2258],desc:"Персонаж в первом ряду наносит удары по находящимся в трех секторах вражеской команды напротив него. Выбранный противник получает 100% урона, двое других - по 50%. Зоны ударов совпадают для всех противников. Удары можно заблокировать или увернуться от них. Максимальный урон по дополнительным целям зависит от уровня приема. Запрещено использование более 1 аналогичного приема за раунд."},{min:421,max:437,added:[2248,2247,2249],desc:"На 1 раунд повышает шансы пробить броню противника. Эффект зависит от уровня приема."},{min:441,max:457,added:[2225,2224,2223],desc:"Каждый удар, причинивший урон, отнимает ОД противника. При ударе в голову ОД теряется в 2 раза больше. Эффект зависит от уровня приема."},{min:481,max:497,added:[2263,2262,2264],desc:"Итоговый урон, который в этом раунде наносится по щитовику и двум его соседям по ряду, уменьшается на 40%. На перемещающихся персонажей прием не действует."},{min:501,max:516,added:[],desc:"Уменьшает защиту противника и его соседей от стихии воды. Эффект зависит от уровня заклинания. Действует 2 раунда, применяется не чаще раза в 3 раунда. От заклинания нельзя увернуться."},{min:521,max:536,added:[],desc:"Уменьшает защиту противника и его соседей от стихии огня. Эффект зависит от уровня заклинания. Действует 2 раунда, применяется не чаще раза в 3 раунда. От заклинания нельзя увернуться."},{min:541,max:556,added:[],desc:"Уменьшает защиту противника и его соседей от стихии воздуха. Эффект зависит от уровня заклинания. Действует 2 раунда, применяется не чаще раза в 3 раунда. От заклинания нельзя увернуться."},{min:561,max:576,added:[],desc:"Уменьшает защиту противника и его соседей от стихии земли. Эффект зависит от уровня заклинания. Действует 2 раунда, применяется не чаще раза в 3 раунда. От заклинания нельзя увернуться."},{min:581,max:596,added:[2234,2233,2232],desc:"Отражает часть магического урона от каждой попавшей в персонажа стрелы обратно в выпустившего ее мага. Отраженный урон зависит от параметров персонажа. Прием не действует на стрелы, уровень которых превышает уровень приема. Стихию, на стрелы которой будет оказывать воздействие прием, можно выбрать в здании гильдии. Запрещено использование более 1 аналогичного приема за раунд."},{min:601,max:617,added:[2240,2239,2238],desc:"В течение следующего раунда число зон, которые сможет атаковать персонаж, возрастает на 1. Шанс успешного применения приема зависит от его уровня."},{min:621,max:637,added:[2254,2253,2255],desc:"Персонаж, стоящий в первом ряду, в этом раунде атакует не только выбранного противника, но и стоящего перед ним или за ним противника. По выбранному персонажу урон наносится в полном объеме, а дополнительная цель получает ((3 + уровень приёма - уровень цели)*35)% от итогового урона, но не менее 35% и не более 140%"},{min:641,max:654,added:[2228,2227,2226],desc:"На 2 раунда понижает шансы противников пробить броню персонажа. Эффект зависит от уровня приема."},{min:661,max:670,added:[2310,2311,2312],desc:"Увеличивает очки атаки и действия мага и его 5 соседей. Применяется не чаще раза в 3 раунда, эффект зависит от уровня заклинания."},{min:681,max:690,added:[2313,2314,2315],desc:"Увеличивает очки защиты и действия мага и его 5 соседей  Применяется не чаще раза в 3 раунда, эффект зависит от уровня заклинания."},{min:701,max:710,added:[2307,2308,2309],desc:"Уменьшает очки атаки и действия противника и его 5 соседей. Применяется не чаще раза в 3 раунда, эффект зависит от уровня заклинания. Увернуться от заклинания нельзя."},{min:721,max:730,added:[2304,2305,2306],desc:"Уменьшает очки защиты и действия противника и его 5 соседей. Применяется не чаще раза в 3 раунда, эффект зависит от уровня заклинания. Увернуться от заклинания нельзя."},{min:741,max:753,added:[2292,2293,2294],desc:"На 1 раунд уменьшает точность и защиту от магии противника и его 5 соседей"},{min:761,max:773,added:[2295,2296,2297],desc:"На 1 раунд уменьшает сокрушение и защиту от магии противника и его 5 соседей"},{min:781,max:793,added:[2298,2299,2300],desc:"На 1 раунд уменьшает уворот и броню противника и его 5 соседей"},{min:801,max:813,added:[2301,2302,2303],desc:"На 1 раунд уменьшает стойкость и броню противника и его 5 соседей"},{min:821,max:835,added:[2280,2281,2282],desc:"На 2 раунда увеличивает уворот и защиту от магии мага и стоящего перед ним воина"},{min:841,max:855,added:[2283,2284,2285],desc:"На 2 раунда увеличивает стойкость и защиту от магии мага и стоящего перед ним воина"},{min:861,max:875,added:[2286,2287,2288],desc:"На 2 раунда увеличивает точность и броню мага и стоящего перед ним воина"},{min:881,max:895,added:[2289,2290,2291],desc:"На 2 раунда увеличивает сокрушение и броню мага и стоящего перед ним воина"},{min:901,max:909,added:[2317,2316,2318],desc:"Наносит по противнику и его 5 соседям урон"},{min:921,max:929,added:[2323,2322,2324],desc:"Наносит по противнику и его 5 соседям урон "},{min:941,max:949,added:[2320,2319,2321],desc:"Наносит по противнику и его 5 соседям урон в течение 3 раундов "},{min:961,max:969,added:[2326,2325,2327],desc:"Наносит по противнику и его 5 соседям урон в течение 3 раундов"},{min:2183,max:2198,added:[2266,2265,2267],desc:"При каждом успешном ударе сжигает часть энергии противника. Эффект зависит от уровня приема"},{min:2331,max:2350,added:[],desc:"В течение 2 следующих раундов число зон, которые сможет блокировать персонаж, возрастает на 1. Шанс успешного применения приема зависит от его уровня."}];