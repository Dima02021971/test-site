var _WinterPresent=function(){var self=this;this.xmlPath="/ajax/winter_present/?action=",this.form=null,this.goldYear=0,this.maxBonus=0,this.currentBonus=0,this.processResponse=function(xmldoc){if(null==xmldoc.getElementsByTagName("root").item(0))return core.alertError("Неверный ответ от сервера"),!1;switch(msg=$("message",xmldoc),msg.length&&("1"==msg.attr("error")?top.core.alertError(msg.text()):top.core.alertMsg(msg.text())),$("xmltype",xmldoc).text()){case"get_data":var params=$("params",xmldoc);self.goldYear=parseInt(params.attr("money_year")),self.maxBonus=parseInt(params.attr("money_max")),self.currentBonus=parseInt(params.attr("money_current")),self.formUpdateContent(),self.form.show()}},this.xmlSend=function(path,xml){top.core.xmlSend(path,xml,self.processResponse)},this.showForm=function(menuItem){this.form||(this.form=$("#wpForm")),this.form.length||this.createForm(),this.xmlSend(self.xmlPath+"get_data","")},this.hideForm=function(){this.form&&this.form.hide()},this.createForm=function(){this.form=$("<div></div>").css({"z-index":"999",width:"100%",height:"\t100%",display:"none",position:"absolute",left:"0px",top:"0px"}).attr("id","wpForm"),this.form.css("display","none"),this.form.appendTo($("body"))},this.formUpdateContent=function(){this.form.html('<div style="position: absolute; width: 100%; height: 100%;"><img src="'+top.core.imgPath+'d3/nquest/1x1ser.png" width="100%" height="100%"></div><div id="winter_present_box" class="winter_present_box" ><div id="winter_present_bg">&nbsp;</div><div class="border_left">&nbsp;</div><div class="border_right">&nbsp;</div><div class="border_left_i">&nbsp;</div><div class="border_right_i">&nbsp;</div><div id="winter_present_layout"><div id="winter_present_DealersButton"><a href="http://dealers.ereality.ru/index.php?do=static&page=dealers" target="_blank"><img src="'+top.core.imgPath+'moroz2012/DealersButton.png" width="162" height="39" /></a></div><div id="winter_present_Yorn"></div><div id="winter_present_Ball"></div><div id="winter_present_BorderTop"></div><div id="winter_present_BorderLeft"></div><div id="winter_present_BorderContent"><div id="winter_present_Content"><h2>Дорогой, '+top.user.name+"!</h2><p>Мы рады сообщить Вам, что стартовала акция «Морозный подарок». Которая продлится только один месяц с 1 декабря по 31 декабря 2011 года.</p><p>Суть акции очень проста: Вы покупаете золото, мы даём Вам в два раза больше (Исключение: установленный лимит на удвоение суммы). Лимит зависит от приобретенного золота в течение года.</p><p>В 2011 году Вы приобрели "+(self.goldYear>1e3?"более <b>1000</b>":"<b>"+self.goldYear+"</b>")+" золота.</p><p>Максимальная сумма, которая будет удвоена при покупке: <b>"+self.maxBonus+"</b> золота.</p><p>То есть, если Вы приобретете в декабре 2011 года <b>"+self.maxBonus+"</b> золота, то получите <b>"+2*self.maxBonus+"</b> золота.</p><p>На данный момент по акции «Морозный подарок - 2011» Вы приобрели <b>"+self.currentBonus+"</b> золота, оставшаяся сумма, которая будет удвоена - <b>"+(self.maxBonus-self.currentBonus)+'</b> золота. Акция действительна до 31 декабря включительно.</p></div></div><div id="winter_present_BorderRight"></div><div class="Clear"></div><div id="winter_present_BorderBottom"></div></div><a href="#" class="close"title="Закрыть" id="wpCloseButton">&nbsp;</a></div>'),$("#wpCloseButton",this.form).click(function(){self.hideForm()})}};